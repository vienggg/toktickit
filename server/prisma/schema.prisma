// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Lab 1 Models
// ---------------------------------------------------------------------------
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

// ---------------------------------------------------------------------------
// Lab 2 Models — Requester Ticketing MVP
// ---------------------------------------------------------------------------

// Renamed from RequesterUser in Lab 3 (D-03). @@map keeps the physical table
// name unchanged so no row moves and every existing Ticket.requesterId FK
// keeps resolving to the same row it always did.
model User {
  id                 Int       @id @default(autoincrement())
  name               String
  email              String    @unique
  department         String
  role               Role      @default(REQUESTER)
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  submittedTickets Ticket[]        @relation("TicketRequester")
  ownedTickets     Ticket[]        @relation("TicketOwner")
  publicComments   PublicComment[]
  internalNotes    InternalNote[]

  // Lab 4: Actions Taken and status history relations.
  actionsCreated  ActionTaken[]         @relation("ActionCreatedBy")
  actionsAssigned ActionTaken[]         @relation("ActionAssignee")
  actionsUpdated  ActionTaken[]         @relation("ActionUpdatedBy")
  statusChanges   TicketStatusHistory[]

  @@index([role])
  @@index([isActive])
  @@map("RequesterUser")
}

model RelatedSystem {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  tickets     Ticket[]
}

model Ticket {
  id                  Int          @id @default(autoincrement())
  ticketNumber        String       @unique
  summary             String
  description         String
  requestedPriority   Priority     @default(MEDIUM) @map("priority")
  itPriority          Priority     @default(MEDIUM)
  status              TicketStatus @default(NEW)
  categoryId          Int
  relatedSystemId     Int?
  requesterId         Int
  ownerId             Int?
  requesterResolvedAt DateTime?
  // Lab 4: optimistic-concurrency counter (BR-25) and lifecycle stamps (BR-22).
  version             Int          @default(1)
  resolvedAt          DateTime?
  closedAt            DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  category       Category              @relation(fields: [categoryId], references: [id])
  relatedSystem  RelatedSystem?        @relation(fields: [relatedSystemId], references: [id])
  requester      User                  @relation("TicketRequester", fields: [requesterId], references: [id])
  owner          User?                 @relation("TicketOwner", fields: [ownerId], references: [id])
  attachments    Attachment[]
  publicComments PublicComment[]
  internalNotes  InternalNote[]
  actionsTaken   ActionTaken[]
  statusHistory  TicketStatusHistory[]

  @@index([requesterId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@index([ownerId])
  @@index([itPriority])
  @@index([updatedAt])
  @@index([ownerId, status])
}

// ---------------------------------------------------------------------------
// Lab 3 Enums — Users, Roles, IT Staff Ticketing, and Admin Screens
// ---------------------------------------------------------------------------
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  NEW
  OPEN
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
  REOPENED
  CANCELLED
}

// Shared communication, visible to Requester, IT Staff, and Administrator.
// Append-only in Lab 3 (BR-21): no update/delete fields or endpoints.
model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

// Operational notes visible only to IT Staff and Administrator (BR-04, BR-24).
// A separate table from PublicComment so a Requester-scoped query can never
// structurally return note content, rather than relying on a filter clause.
model InternalNote {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  body      String
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([ticketId, createdAt])
}

model Attachment {
  id            Int       @id @default(autoincrement())
  ticketId      Int
  fileName      String
  fileUrl       String
  fileSize      Int
  mimeType      String
  isRemoved     Boolean   @default(false)
  removedReason String?
  removedAt     DateTime?
  uploadedAt    DateTime  @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Lab 4 — Actions Taken and Ticket status history
// ---------------------------------------------------------------------------
enum ActionStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Work recorded under a Ticket (BR-01). Never deleted (BR-13): the FK is
// RESTRICT, not CASCADE, so deleting a Ticket with recorded work fails loudly.
// Two CHECK constraints live in the migration SQL (Prisma cannot express them):
//   followUpRequired => followUpNote is non-blank   (BR-09)
//   status = COMPLETED => result is non-blank       (BR-08)
model ActionTaken {
  id               Int          @id @default(autoincrement())
  ticketId         Int
  actionAt         DateTime
  description      String
  result           String?
  status           ActionStatus @default(PLANNED)
  followUpRequired Boolean      @default(false)
  followUpNote     String?
  attachmentNotes  String?
  createdById      Int
  assigneeId       Int
  updatedById      Int?
  clientRequestId  String?
  version          Int          @default(1)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  completedAt      DateTime?

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  createdBy User   @relation("ActionCreatedBy", fields: [createdById], references: [id])
  assignee  User   @relation("ActionAssignee", fields: [assigneeId], references: [id])
  updatedBy User?  @relation("ActionUpdatedBy", fields: [updatedById], references: [id])

  @@unique([ticketId, clientRequestId])
  @@index([ticketId, actionAt, id])
  @@index([assigneeId, status])
}

// Append-only audit trail of status changes (BR-24). No update/delete path.
model TicketStatusHistory {
  id          Int          @id @default(autoincrement())
  ticketId    Int
  fromStatus  TicketStatus
  toStatus    TicketStatus
  changedById Int
  reason      String?
  createdAt   DateTime     @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([ticketId, createdAt, id])
}
